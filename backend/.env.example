# MySQL PHP API (OVH) — the API runs inside OVH and reaches naitkcodb
MYSQL_API_URL=https://naitk.com/api/
# Set the real token in .env (do not commit it)
MYSQL_API_TOKEN=your_mysql_api_token_here

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000